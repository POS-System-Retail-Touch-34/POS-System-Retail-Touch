# RetailTouch backend environment example
# Copy this file to Backend/.env and fill real values before running locally.
# Do not commit Backend/.env.

# Shared security
JWT_SECRET=
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000
AUTH_SETTINGS_ENCRYPTION_KEY=

# CORS and frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*
CORS_EXPOSED_HEADERS=X-Total-Count,X-Page-Number,Content-Disposition
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=3600
FRONTEND_HOST_PORT=3000
VITE_API_URL=http://gateway-service:8080

# Logging and actuator
LOG_LEVEL_RETAILTOUCH=INFO
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_SECURITY=WARN
LOG_LEVEL_GATEWAY=INFO
LOG_LEVEL_WEB=INFO
LOG_FILE_PATH=logs/application.log
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_HISTORY=10
ACTUATOR_ENDPOINTS=health,info
ACTUATOR_BASE_PATH=/actuator
ACTUATOR_HEALTH_SHOW_DETAILS=never

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_SENSITIVE_ENDPOINTS=/auth/login,/auth/register,/auth/password-reset,/sales/payments/razorpay/verify

# MySQL for auth-service
MYSQL_IMAGE_TAG=8.0
MYSQL_HOST_PORT=3310
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3306
AUTH_DB_NAME=retailtouch_auth
AUTH_DB_USERNAME=root
AUTH_DB_PASSWORD=
AUTH_DB_CREATE_IF_NOT_EXISTS=true
AUTH_DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true
AUTH_DB_USE_SSL=false
AUTH_DB_SERVER_TIMEZONE=UTC
AUTH_JPA_DDL_AUTO=update
AUTH_JPA_SHOW_SQL=false
AUTH_JPA_FORMAT_SQL=false

# Generic datasource values for shared security profile
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retailtouch
DB_USER=root
DB_PASSWORD=
DB_USE_SSL=false
DB_REQUIRE_SSL=false
DB_SERVER_TIMEZONE=UTC

# MongoDB
MONGODB_IMAGE_TAG=6.0
MONGODB_HOST_PORT=27017
MONGODB_URI=mongodb://localhost:27017/retailtouch
INVENTORY_MONGODB_URI=mongodb://localhost:27017/retailtouch_inventory
INVENTORY_MONGODB_DATABASE=retailtouch_inventory
SALES_MONGODB_URI=mongodb://localhost:27017/retailtouch_sales
SALES_MONGODB_DATABASE=retailtouch_sales
CUSTOMER_MONGODB_URI=mongodb://localhost:27017/retailtouch_customers
CUSTOMER_MONGODB_DATABASE=retailtouch_customers
REPORTING_MONGODB_URI=mongodb://localhost:27017/retailtouch_sales
REPORTING_MONGODB_DATABASE=retailtouch_sales

# RabbitMQ
RABBITMQ_IMAGE_TAG=3-management
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Local service ports
GATEWAY_SERVICE_PORT=8080
AUTH_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
SALES_SERVICE_PORT=8083
CUSTOMER_SERVICE_PORT=8084
REPORTING_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086

# Local service URLs
AUTH_SERVICE_URL=http://localhost:8081
INVENTORY_SERVICE_URL=http://localhost:8082
SALES_SERVICE_URL=http://localhost:8083
CUSTOMER_SERVICE_URL=http://localhost:8084
REPORTING_SERVICE_URL=http://localhost:8085
NOTIFICATION_SERVICE_URL=http://localhost:8086

# Docker service URLs and hosts
DOCKER_AUTH_DB_HOST=mysql
DOCKER_RABBITMQ_HOST=rabbitmq
DOCKER_AUTH_SERVICE_URL=http://auth-service:8081
DOCKER_INVENTORY_SERVICE_URL=http://inventory-service:8082
DOCKER_SALES_SERVICE_URL=http://sales-service:8083
DOCKER_CUSTOMER_SERVICE_URL=http://customer-service:8084
DOCKER_REPORTING_SERVICE_URL=http://reporting-service:8085
DOCKER_NOTIFICATION_SERVICE_URL=http://notification-service:8086
DOCKER_INVENTORY_MONGODB_URI=mongodb://mongodb:27017/retailtouch_inventory
DOCKER_SALES_MONGODB_URI=mongodb://mongodb:27017/retailtouch_sales
DOCKER_CUSTOMER_MONGODB_URI=mongodb://mongodb:27017/retailtouch_customers
DOCKER_REPORTING_MONGODB_URI=mongodb://mongodb:27017/retailtouch_sales

# Auth bootstrap users
AUTH_ALLOW_SELF_REGISTRATION=false
AUTH_BOOTSTRAP_DEFAULT_USERS=false
AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AUTH_BOOTSTRAP_ADMIN_PASSWORD=
AUTH_BOOTSTRAP_MANAGER_USERNAME=manager
AUTH_BOOTSTRAP_MANAGER_EMAIL=manager@example.com
AUTH_BOOTSTRAP_MANAGER_PASSWORD=
AUTH_BOOTSTRAP_CASHIER_USERNAME=cashier
AUTH_BOOTSTRAP_CASHIER_EMAIL=cashier@example.com
AUTH_BOOTSTRAP_CASHIER_PASSWORD=

# Sales and payments
FEIGN_CONNECT_TIMEOUT=5000
FEIGN_READ_TIMEOUT=5000
TAX_RATE=0.18
INVOICE_PREFIX=INV
LOYALTY_CONVERSION_RATE=1
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_ORDERS_URL=https://api.razorpay.com/v1/orders
INVENTORY_LOW_STOCK_THRESHOLD=10
